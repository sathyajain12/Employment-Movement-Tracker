{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movement-register",
  "main": "src/index.js",
  // Keep at this value: the local runtime does not support a newer date.
  "compatibility_date": "2026-10-30",

  // One Worker serves both the web app (built into web/dist) and the API, so they share an
  // origin and the session cookie stays first-party. /api/* always runs the Worker; any other
  // path is a static file, or index.html so client-side routes like /admin/register work.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "movement-register-db",
      "database_id": "9fd71ee3-9325-4952-854b-e82c141cd24a",
      "migrations_dir": "migrations"
    }
  ],

  // Cron runs in UTC; the office is IST (UTC+05:30). Keep in sync with src/jobs/*.
  "triggers": {
    "crons": [
      "*/10 3-12 * * 1-6", // overdue check, 08:30–18:20 IST, Mon–Sat
      "0 12 * * 1-6"       // end-of-day close, 17:30 IST, Mon–Sat
    ]
  },

  // Non-secret production values. Local dev overrides these from .dev.vars.
  // Secrets (JWT_SECRET, GOOGLE_CLIENT_SECRET, ADMIN_EMAILS) are set with `wrangler secret put`.
  "vars": {
    "APP_URL": "https://movement-register.coeoffice.workers.dev",
    "GOOGLE_CLIENT_ID": "378803562974-9h25vtdt4stjaitg66fnulbpn5g00291.apps.googleusercontent.com",
    "ALLOWED_DOMAIN": "sssihl.edu.in"
  },

  "observability": {
    "enabled": true
  }
}
